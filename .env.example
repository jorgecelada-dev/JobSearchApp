# Base de datos (SQLite, un único archivo)
DATABASE_URL="file:./dev.db"

# Anthropic (clasificación, borradores, parser de ofertas)
ANTHROPIC_API_KEY=

# InfoJobs API oficial (https://developer.infojobs.net)
INFOJOBS_CLIENT_ID=
INFOJOBS_CLIENT_SECRET=

# Google Places API (generar lista de empresas locales)
GOOGLE_PLACES_API_KEY=

# Envío de emails (SMTP)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Autofill: false = Playwright se detiene antes del envío final
AUTOFILL_AUTO_SUBMIT=false

# Jobtoday: milisegundos mínimos entre peticiones
JOBTODAY_MIN_DELAY_MS=3000

# Candidaturas
APPLICANT_NAME=          # opcional: el nombre se define en el dashboard (Cuentas y CV)
MIN_MATCH_SCORE=40       # por debajo no se crea candidatura
COMPANY_MIN_DELAY_MS=2000   # espera mínima entre peticiones al mismo sitio
