# Base de datos (SQLite, un único archivo)
DATABASE_URL="file:./dev.db"

# Las claves de abajo son OPCIONALES: lo normal es guardarlas desde el dashboard
# (pestañas «Fuentes» y «Cuentas y CV»), que las cifra en el almacén seguro del sistema.
# El email para enviar candidaturas se conecta solo desde «Cuentas y CV».

# Anthropic: clasificación con IA de las ofertas dudosas (se enciende en «Fuentes»)
ANTHROPIC_API_KEY=

# Portales (https://developer.infojobs.net · https://developer.adzuna.com · https://jooble.org/api/about)
INFOJOBS_CLIENT_ID=
INFOJOBS_CLIENT_SECRET=
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
JOOBLE_API_KEY=

# Google Places API (generar lista de empresas locales; de pago)
GOOGLE_PLACES_API_KEY=

# Candidaturas
APPLICANT_NAME=          # opcional: el nombre se define en el dashboard (Cuentas y CV)
MIN_MATCH_SCORE=40       # por debajo no se crea candidatura
COMPANY_MIN_DELAY_MS=2000   # espera mínima entre peticiones al mismo sitio
