{
  "name": "jobsearchapp",
  "version": "1.0.0",
  "description": "Automatización personal de búsqueda de empleo con revisión humana",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:studio": "prisma studio",
    "db:seed": "tsx prisma/seed.ts",
    "dashboard:dev": "vite --config src/dashboard/vite.config.ts",
    "dashboard:build": "vite build --config src/dashboard/vite.config.ts",
    "postinstall": "prisma generate",
    "server": "tsx watch src/server/index.ts",
    "dev": "concurrently -n api,web -c blue,green \"npm:server\" \"npm:dashboard:dev\"",
    "db:seed:demo": "tsx prisma/seed-demo.ts",
    "classify": "tsx src/matching/run.ts",
    "test": "node --import tsx --test \"src/**/*.test.ts\"",
    "companies": "tsx src/scrapers/companies/cli.ts",
    "scheduler": "tsx src/scheduler.ts"
  },
  "keywords": [],
  "author": "",
  "license": "UNLICENSED",
  "type": "module",
  "dependencies": {
    "@anthropic-ai/sdk": "^0.127.0",
    "@hono/node-server": "^2.1.1",
    "@prisma/adapter-better-sqlite3": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "cheerio": "^1.2.0",
    "dotenv": "^18.0.1",
    "hono": "^4.13.8",
    "node-cron": "^4.6.0",
    "nodemailer": "^10.0.10",
    "playwright": "^1.63.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^26.6.2",
    "@types/nodemailer": "^8.0.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/smtp-server": "^3.5.13",
    "@vitejs/plugin-react": "^6.1.1",
    "concurrently": "^10.0.5",
    "prisma": "^7.10.0",
    "smtp-server": "^3.19.13",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2",
    "vite": "^8.3.0"
  },
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "allowScripts": {
    "better-sqlite3@12.11.1": true,
    "prisma@7.10.0": true,
    "@prisma/engines@7.10.0": true,
    "esbuild@0.28.2": true
  }
}
